# Copy to backend/.env (never commit the real file) or set these in the service environment.

# Where the server listens. Use 0.0.0.0 on the VM, behind the reverse proxy.
OBEYA_HOST=127.0.0.1
OBEYA_PORT=8787

# Storage. Leave empty for a SQLite file at backend/data/obeya.db (no setup needed).
# Give a path or sqlite:///path to put the file elsewhere, or a postgresql:// URL to use
# Postgres (then install the driver: uv sync --extra postgres).
DATABASE_URL=

# Jira. Leave both empty to run without Jira; linked bars then say "Jira is not connected".
JIRA_BASE_URL=
JIRA_TOKEN=
# bearer = Data Center / Server personal access token. basic = Cloud (also set JIRA_EMAIL).
JIRA_AUTH=bearer
JIRA_EMAIL=
# Path to a CA bundle when Jira uses an internal certificate authority.
JIRA_CA_BUNDLE=
# An outbound proxy is picked up from the standard HTTPS_PROXY / NO_PROXY variables.

# Who may edit. Nothing is needed here for the passcode: it is set in the app, under Customize.
# To let a sign-in proxy name the editors instead (or as well), give the header it sets and
# the names allowed to edit ("*" = anyone it lets in). Only do this when the server cannot be
# reached except through that proxy, because anyone who can reach it directly can send the header.
OBEYA_AUTH_HEADER=
OBEYA_EDITORS=
# Hours a browser stays unlocked after the passcode is entered.
OBEYA_EDIT_SESSION_HOURS=12

# Seconds between full Jira syncs (minimum 30).
OBEYA_SYNC_SECONDS=300
